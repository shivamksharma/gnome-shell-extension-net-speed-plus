# =============================================================================
# Net Speed Plus — .gitignore
# =============================================================================

# --- Build and packaging output ---
/build/
/dist/
*.shell-extension.zip
*.zip

# Compiled GSettings schemas (generated; never shipped)
gschemas.compiled

# --- Dependencies ---
node_modules/

# --- Python virtual environments and bytecode ---
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Editors and IDEs ---
.vscode/
.idea/
*.code-workspace
.project
.settings/
*.swp
*.swo
*.swn
*~
*.bak
*.orig
*.rej

# --- Operating system files ---
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Desktop.ini
desktop.ini

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Test output and coverage ---
/coverage/
.nyc_output/
.eslintcache

# --- Environment and secrets ---
.env
.env.*
!.env.example

# --- Temporary files ---
*.tmp
*.temp
.cache/
